VITE_API_URL=http://localhost:4000/api

# Firebase WEB app configuration (Firebase console > Project settings > Your apps > Web app).
# These values are PUBLIC by design (they identify the project, they do not grant access).
# NEVER put a service-account key or any Admin SDK credential in a VITE_* variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: use the local Auth emulator instead of the real project (development only; refused in production builds).
# With the emulator any placeholder values above work, e.g. VITE_FIREBASE_API_KEY=demo-api-key
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Judge demo only, development server only (`npm run dev`): shows a Demo login panel (emails only, no passwords). Production builds ignore it.
# VITE_DEMO_MODE=true
