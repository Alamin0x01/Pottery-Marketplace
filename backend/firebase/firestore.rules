rules_version = '2';

// Deny-all. Every read and write goes through the Express backend (Admin SDK, which bypasses rules).
// Browsers and devices must never touch Firestore directly: authorization lives in the API layer
// (see docs/SYSTEM_ARCHITECTURE.md §6). Do not add rules here without updating that design.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
