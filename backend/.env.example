# Copy to .env (never commit .env). Validated at boot by src/config/env.js and src/config/firebase.js.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (customer site, admin site)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Vercel/most hosts sit behind one reverse proxy; set to 0 when running without one
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Firebase (see docs/FIREBASE_SETUP.md). Required in every mode.
# ---------------------------------------------------------------------------
# Project ID from the Firebase console (not a secret).
FIREBASE_PROJECT_ID=
# Leave EMPTY on the Spark plan: Cloud Storage is not used. Demo product images are static files in
# web/public/images/products/ (see docs/FIREBASE_SETUP.md, "Product images").
FIREBASE_STORAGE_BUCKET=

# MODE A - real project. Provide ONE of the following (the key must belong to FIREBASE_PROJECT_ID):
#   FIREBASE_SERVICE_ACCOUNT_B64  base64 of the service-account JSON. Use this on Vercel/VPS.
#                                 PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   GOOGLE_APPLICATION_CREDENTIALS absolute path to the JSON key file on your own machine (keep it outside the repo)
# These are SECRETS: never commit them, never put them in the frontend.
FIREBASE_SERVICE_ACCOUNT_B64=
GOOGLE_APPLICATION_CREDENTIALS=

# MODE B - local Firebase emulators (no real data, no credentials). Set ALL THREE, or none.
# Refused when NODE_ENV=production. Start them with `npm run emulators`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# A device counts as "online" (admin dashboard) if it contacted the server within this many seconds. Default 900.
# DEVICE_ONLINE_WINDOW_SEC=900

# Added in later phases (documented here so they are not forgotten):
# GEMINI_API_KEY=                (Phase 6; secret)
# GEMINI_MODEL=                  (Phase 6)
# NOTIFICATION_ESCALATION_MINUTES=120   (Phase 9)
